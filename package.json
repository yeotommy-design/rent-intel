{
  "name": "rentintel-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "RentIntel prototype with a lightweight auth backend",
  "scripts": {
    "start": "node server.js",
    "audit:search": "node ./scripts/audit-sample-search.mjs",
    "monitor:sources": "node ./scripts/update-source-health.mjs",
    "test:source-health": "node ./scripts/test-source-health-monitor.mjs",
    "test:asking-ingestion": "node ./scripts/test-asking-feed-ingestion.mjs",
    "test:asking-storage": "node ./scripts/test-supabase-asking-feed-store.mjs",
    "sync:ura-benchmark": "node ./scripts/sync-ura-commercial-rental-index.mjs",
    "test:ura-benchmark": "node ./scripts/test-ura-commercial-rental-index.mjs",
    "test:onemap": "node ./scripts/test-onemap-live-client.mjs",
    "consolidate:sample-data": "node ./scripts/consolidate-sample-data.mjs",
    "draft:market-notes": "node ./scripts/generate-weekly-market-note.mjs",
    "test:market-notes-source": "node ./scripts/test-market-note-source-evidence.mjs",
    "write:market-notes:weekly": "node ./scripts/generate-weekly-market-note.mjs --write",
    "verify:production": "node ./scripts/spot-check-production.mjs",
    "build:market-notes": "node ./scripts/build-market-notes.mjs",
    "check:market-notes": "node ./scripts/check-market-notes-generated.mjs",
    "publish:market-notes": "npm run build:market-notes && npm run check:market-notes && npm run verify:market-notes",
    "release:market-notes": "node ./scripts/release-market-notes.mjs",
    "submit:sitemap": "node ./scripts/submit-sitemap-search-console.mjs",
    "verify:market-notes": "node ./scripts/verify-market-notes-live.mjs"
  }
}
